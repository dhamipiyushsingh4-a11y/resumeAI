# MongoDB Atlas connection string. URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/resumeai
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
# Create a key in Google AI Studio. Keep this server-side only.
GEMINI_API_KEY=your_gemini_api_key
NEXT_PUBLIC_APP_URL=http://localhost:3000
